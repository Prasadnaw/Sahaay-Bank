        <video id="faceEnrollVideo" class="face-video-elem" autoplay playsinline muted></video>
        <div class="face-reticle-overlay" id="faceEnrollReticle"></div>
      </div>

      <div id="faceEnrollStatus" style="font-size:.95rem; font-weight:700; margin:8px 0; color:var(--navy);" aria-live="polite">
        Starting camera preview...
      </div>
      <div id="faceEnrollError" class="field-error" style="margin:8px 0;" hidden></div>

      <div style="display:flex; gap:10px; margin-top:14px;">
        <button type="button" class="btn-primary" id="faceEnrollCaptureBtn" style="flex:1;" disabled>
          📸 Capture & Save Face
        </button>
      </div>
    </div>
  </div>

  <!-- ==================== FACE LOGIN MODAL ==================== -->
  <div class="modal-overlay" id="faceLoginModal" role="dialog" aria-modal="true" aria-labelledby="faceLoginTitle">
    <div class="modal" style="max-width:520px; text-align:center; position:relative;">
      <button class="modal-close-btn" id="closeFaceLoginBtn" aria-label="Close Face Login">✕</button>
      <div style="display:flex; justify-content:center; align-items:center; margin-bottom:12px;">
        <h3 id="faceLoginTitle" style="margin:0; font-size:1.25rem; display:flex; align-items:center; gap:8px;">
          <span>📸</span> <span>Face Recognition Sign-In</span>
        </h3>
      </div>

      <p style="font-size:.92rem; color:var(--ink-soft); margin:0 0 14px 0;">
        Look directly at your camera. Sahaay will recognize your face and sign you in without passwords.
      </p>

      <!-- Video Feed & Viewfinder Reticle -->
      <div class="qr-camera-wrap" style="height:300px; border-radius:12px; overflow:hidden; position:relative; background:#0B0F19; margin-bottom:14px;">
        <video id="faceLoginVideo" playsinline autoplay muted style="width:100%; height:100%; object-fit:cover; transform:scaleX(-1);"></video>
        <canvas id="faceLoginCanvas" style="display:none;"></canvas>
        
        <!-- Viewfinder Reticle -->
        <div id="faceLoginReticle" style="position:absolute; top:50%; left:50%; transform:translate(-50%, -50%); width:190px; height:230px; border:3px dashed #60A5FA; border-radius:115px; pointer-events:none; box-shadow:0 0 0 9999px rgba(0,0,0,0.45); transition:all 0.3s ease;">
          <div id="faceReticleBadge" style="position:absolute; top:12px; left:50%; transform:translateX(-50%); font-size:.72rem; color:#93C5FD; font-weight:700; text-transform:uppercase; letter-spacing:1px; background:rgba(0,0,0,0.65); padding:2px 8px; border-radius:4px; white-space:nowrap;">
            Position Face
          </div>
        </div>

        <!-- Camera Fallback Banner -->
        <div id="faceLoginFallback" style="display:none; position:absolute; inset:0; background:#0F172A; color:#F8FAFC; flex-direction:column; align-items:center; justify-content:center; padding:20px; z-index:10;">
          <span style="font-size:2.5rem; margin-bottom:8px;">📷</span>
          <strong style="font-size:1.05rem; margin-bottom:6px;">Camera Access Unavailable</strong>
          <p style="font-size:.85rem; color:#94A3B8; text-align:center; margin-bottom:14px;">
            Select your demo user profile below to sign in instantly with biometric face profile.
          </p>
        </div>
      </div>

      <div id="faceLoginStatus" style="font-size:1rem; font-weight:700; color:var(--navy); min-height:26px; margin-bottom:14px;">
        Looking for face... Please keep your head steady.
      </div>

      <!-- 1-Tap Demo User Biometric Selector for Instant Testing -->
      <div style="padding:12px; background:var(--bg); border:1.5px solid var(--border); border-radius:8px; margin-bottom:14px; text-align:left;">
        <span style="font-size:.8rem; font-weight:700; color:var(--ink-soft); display:block; margin-bottom:8px; text-transform:uppercase; letter-spacing:0.5px;">
          Instant Demo Face Profiles:
        </span>
        <div id="faceLoginProfilesContainer" style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:8px; max-height:160px; overflow-y:auto;">
          <button type="button" class="btn-secondary demo-face-login-btn" data-user="asha.patel" style="font-size:.82rem; padding:8px 4px; text-align:center;">
            👤 Asha Patel
            <small style="display:block; opacity:.7; font-size:.7rem;">Standard</small>
          </button>
          <button type="button" class="btn-secondary demo-face-login-btn" data-user="rajesh.kumar" style="font-size:.82rem; padding:8px 4px; text-align:center;">
            👤 Rajesh Kumar
            <small style="display:block; opacity:.7; font-size:.7rem;">Blind / Voice</small>
          </button>
          <button type="button" class="btn-secondary demo-face-login-btn" data-user="meera.sharma" style="font-size:.82rem; padding:8px 4px; text-align:center;">
            👤 Meera Sharma
            <small style="display:block; opacity:.7; font-size:.7rem;">Senior / Motor</small>
          </button>
        </div>
      </div>

      <button type="button" class="btn-secondary" id="cancelFaceLoginBtn" style="width:100%;">
        Sign in with Password Instead
      </button>
    </div>
  </div>

  <!-- Face Verification Prompt Modal -->
  <div class="modal-overlay" id="faceVerifyModal" role="dialog" aria-modal="true" aria-labelledby="faceVerifyTitle">
    <div class="modal" style="max-width:440px; text-align:center;">
      <button class="modal-close-btn" id="closeFaceVerifyBtn" aria-label="Cancel face verification">✕</button>
      <div style="display:inline-flex; align-items:center; gap:6px; background:var(--gold); color:var(--navy-dark); font-size:.8rem; font-weight:800; padding:4px 10px; border-radius:20px; margin-bottom:8px;">
        <span>🛡️ BIOMETRIC AUTHORIZATION</span>
      </div>
      <h2 id="faceVerifyTitle" style="margin:0 0 4px 0;">Look at Camera to Authorize</h2>
      <p style="font-size:.88rem; color:var(--ink-soft); margin:0 0 10px 0;">Hold steady inside the frame to verify payment.</p>

      <div class="face-video-wrapper">
        <video id="faceVerifyVideo" class="face-video-elem" autoplay playsinline muted></video>
        <div class="face-reticle-overlay" id="faceVerifyReticle"></div>
        <div class="face-scan-line"></div>
      </div>

      <div id="faceVerifyStatus" style="font-size:.95rem; font-weight:700; margin:8px 0; color:var(--navy);" aria-live="polite">
        Verifying identity...
      </div>
      <div id="faceVerifyError" class="field-error" style="margin:8px 0;" hidden></div>

      <div style="margin-top:14px;">
        <button type="button" class="btn-secondary" id="faceVerifyFallbackPinBtn" style="width:100%; font-weight:700;">
          🔢 Cancel & Use 4-Digit UPI PIN Instead
        </button>
      </div>
    </div>
  </div>

  <div class="toast" id="toast" role="status" aria-live="polite"></div>

  <!-- Modular Scripts -->
  <script src="js/config.js"></script>
  <script src="js/api.js"></script>
  <script src="js/i18n.js"></script>
  <script src="js/faceAuth.js"></script>
  <script src="js/voiceEngine.js"></script>
  <script src="js/upiService.js"></script>
  <script src="js/jsqr.js"></script>
  <script src="js/qrcode.min.js"></script>
  <script src="js/qrService.js"></script>
  <script src="js/a11yToolbar.js"></script>
  <script src="js/aiCompanion.js"></script>
  <script src="js/app.js"></script>
</body>
</html>
