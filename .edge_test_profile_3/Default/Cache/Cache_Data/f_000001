<!DOCTYPE html>
<html lang="en" class="fresh-theme">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sahaay Bank — Accessible UPI & Digital Banking</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Serif:wght@500;600;700&display=swap" rel="stylesheet">
  
  <!-- Modular Stylesheets -->
  <link rel="stylesheet" href="css/variables.css">
  <link rel="stylesheet" href="css/base.css">
  <link rel="stylesheet" href="css/toolbar.css">
  <link rel="stylesheet" href="css/components.css">
  <link rel="stylesheet" href="css/upi-qr.css">
</head>
<body>
  <a href="#main-content" class="skip-link" data-i18n="skipLink">Skip to main content</a>

  <!-- DWELL CLICK VISUAL INDICATOR -->
  <div id="dwellIndicator" aria-hidden="true"></div>

  <!-- SITE HEADER (LOGO & BRANDING AT TOP) -->
  <header class="site-header" role="banner">
    <div class="brand">
      <svg width="46" height="46" viewBox="0 0 42 42" aria-hidden="true" focusable="false">
        <rect width="42" height="42" rx="8" fill="#10384C"/>
        <path d="M21 8 L34 15 V17 H8 V15 Z" fill="#C29333"/>
        <rect x="11" y="19" width="4" height="13" fill="#fff"/>
        <rect x="19" y="19" width="4" height="13" fill="#fff"/>
        <rect x="27" y="19" width="4" height="13" fill="#fff"/>
        <rect x="8" y="33" width="26" height="3" fill="#C29333"/>
      </svg>
      <div class="brand-text">
        <div class="name" id="brandName" data-standard="Sahaay Bank" data-plain="My Easy Bank" data-i18n="brandName">Sahaay Bank</div>
        <div class="tag" id="brandTag" data-standard="Universal Multilingual & Accessible Digital Banking" data-plain="Banking made simple in your language" data-i18n="brandTag">Universal Multilingual & Accessible Digital Banking</div>
      </div>
    </div>

    <div class="header-badges">
      <button type="button" class="btn-secondary" id="openScannerQuickBtn" style="min-height:38px; padding:6px 12px; font-size:.88rem;" aria-label="Scan any UPI QR code to pay">
        📷 <span data-i18n="btnScanQrHeader">Scan QR</span>
      </button>
      <button type="button" class="btn-secondary" id="openMyQrQuickBtn" style="min-height:38px; padding:6px 12px; font-size:.88rem;" aria-label="Show my own UPI QR code">
        📱 <span data-i18n="btnMyQrHeader">My QR</span>
      </button>
      <button type="button" class="a11y-btn" id="quickThemeBtn" style="min-height:38px; padding:6px 12px; font-size:.88rem;" aria-label="Toggle dark theme">
        ✨ <span data-i18n="themeBtnText">Fresh Modern</span>
      </button>
      <button class="audit-badge" id="openAuditBtn" aria-label="Open continuous accessibility audit report (100% compliant)">
        <span aria-hidden="true">✓</span> <span data-i18n="auditPassingBadge">Live a11y: 100% Passing</span>
      </button>
      <span class="demo-flag" data-i18n="demoBadge">FULL-STACK READY</span>
    </div>
  </header>

  <!-- ACCESSIBILITY TOOLBAR (BELOW SITE HEADER) -->
  <aside class="a11y-bar" id="mainA11yBar" role="region" aria-label="Accessibility settings and assistive tools">
    <span class="label" data-i18n="assistiveToolsLabel">Assistive Tools:</span>

    <button class="a11y-btn" id="tool-wizard" aria-haspopup="dialog" style="background:var(--gold); color:var(--navy-dark); font-weight:800; border-color:var(--gold);" title="Open Accessibility Setup Wizard for Disabilities">
      ♿ <span>Setup Wizard</span>
    </button>

    <div class="a11y-group" id="tool-text-size" role="group" aria-label="Text size scale">
      <button class="a11y-btn" id="textSmaller" aria-label="Decrease text size (A minus)">A−</button>
      <button class="a11y-btn" id="textReset" aria-label="Reset text size to standard (A)">A</button>
      <button class="a11y-btn" id="textBigger" aria-label="Increase text size (A plus)">A+</button>
      <button class="a11y-btn" id="textMax" aria-label="Maximum text size (A double plus)">A++</button>
    </div>

    <button class="a11y-btn" id="tool-contrast" aria-pressed="false" title="Switch to black and yellow AAA high contrast">
      👁️ <span data-i18n="toolContrast">High contrast</span>
    </button>
    <button class="a11y-btn" id="tool-plain" aria-pressed="false" title="Simplify financial terms into plain everyday English">
      📖 <span data-i18n="toolPlain">Plain language</span>
    </button>
    <button class="a11y-btn" id="tool-click-read" aria-pressed="false" title="Click any box, card, or select text on screen to hear it spoken aloud">
      🔊 <span data-i18n="toolClickRead">Select to speech</span>
    </button>
    <button class="a11y-btn" id="tool-explore" aria-pressed="false" title="First click announces action; second click confirms">
      🛡️ <span data-i18n="toolExplore">Two-click safe mode</span>
    </button>
    <button class="a11y-btn" id="tool-hover" aria-pressed="false" title="Automatically click buttons by hovering over them for 1.2 seconds">
      ⏱️ <span data-i18n="toolHover">Hover select</span>
    </button>
    <button class="a11y-btn" id="tool-osk" aria-pressed="false" title="Open or close on-screen virtual keyboard for typing">
      ⌨️ <span data-i18n="toolOsk">Virtual keyboard</span>
    </button>
    <button class="a11y-btn" id="tool-tags" aria-pressed="false" title="Highlight important numbers, dates, and amounts">
      🏷️ <span data-i18n="toolTags">Highlight key info</span>
    </button>
    <button class="a11y-btn" id="tool-voice-alerts" aria-pressed="false" title="Speak all system notifications aloud">
      🗣️ <span data-i18n="toolVoiceAlerts">Voice alerts</span>
    </button>
    <button class="a11y-btn" id="tool-motion" aria-pressed="false" title="Stop all transitions and animations">
      🚫 <span data-i18n="toolMotion">Reduce motion</span>
    </button>
  </aside>

  <!-- MULTILINGUAL VOICE ACTION STRIP -->
  <section class="voice-action-bar" id="tool-voice-bar" role="region" aria-label="Multilingual Voice Action Navigation System">
    <div class="voice-main-controls">
      <button type="button" class="voice-mic-btn" id="voiceActionMicBtn" aria-label="Activate voice command system">
        <span class="mic-icon" aria-hidden="true">🎙️</span>
        <span id="voiceMicBtnText" data-i18n="voiceMicBtn">Start Voice Action</span>
      </button>

      <label for="voiceLangSelect" class="sr-only">Voice Language Mode</label>
      <select id="voiceLangSelect" class="voice-lang-select" aria-label="Select voice language or auto detect">
        <option value="auto" selected>🌐 Auto-Detect Language (स्वचालित भाषा)</option>
        <option value="en-IN">🇬🇧 English (India)</option>
        <option value="hi-IN">🇮🇳 हिन्दी (Hindi)</option>
        <option value="ta-IN">🇮🇳 தமிழ் (Tamil)</option>
      </select>
      <span id="detectedLangBadge" aria-live="polite"></span>
    </div>

    <div class="voice-status-display" id="voiceLiveStatusBox" aria-live="polite">
      <span data-i18n="voiceLiveHint">💡 Say: "Raju ko paise bhejiye", "Mera QR dikhao", "Scan QR", "Help", or "Freeze account"</span>
    </div>
  </section>

  <!-- LIVE SCREEN READER REGIONS -->
  <div id="liveRegion" class="sr-only" role="status" aria-live="polite"></div>
  <div id="liveRegionAssertive" class="sr-only" role="alert" aria-live="assertive"></div>

  <!-- DEDICATED PRE-LOGIN VIEW: ACCESSIBILITY & DISABILITY ASSESSMENT -->
  <main id="accessibilityAssessmentView" class="main-content" style="max-width:880px; margin:24px auto;" role="main" aria-labelledby="preLoginTitle" data-readable>
    <div class="panel" style="padding:24px;">
      <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px; margin-bottom:14px;">
        <div style="display:inline-flex; align-items:center; gap:8px; background:var(--gold); color:var(--navy-dark); font-weight:800; font-size:.84rem; padding:4px 12px; border-radius:20px;">
          <span>♿ STEP 1 OF 2: DISABILITY & ASSISTANCE SETUP</span>
        </div>
        <button type="button" class="btn-secondary" id="skipAssessmentDirectBtn" style="padding:6px 14px; font-weight:700;">
          Skip to Standard Login →
        </button>
      </div>

      <h1 id="preLoginTitle" style="font-size:1.8rem; margin:0 0 8px 0; color:var(--navy);">Welcome to Sahaay Accessible Banking</h1>
      <p style="font-size:1.05rem; color:var(--ink); margin:0 0 16px 0; line-height:1.5;">
        Please tell us or select how you would like to interact with Sahaay Bank. We will personalize your screen, controls, and login method according to your assistance needs.
      </p>

      <!-- Live Voice Guided Setup Box -->
      <div class="wizard-speech-banner" id="preLoginSpeechBanner" style="margin-bottom:20px;">
        <div style="display:flex; align-items:center; gap:12px;">
          <span style="font-size:1.8rem;">🎙️</span>
          <div>
            <strong style="font-size:1.02rem;">Hands-Free Voice Selection Active:</strong>
            <p style="margin:2px 0 0 0; font-size:.92rem;" id="preLoginSpeechStatus">Listening... Speak: <strong>"Blind"</strong>, <strong>"Low Vision"</strong>, <strong>"Motor"</strong>, <strong>"Senior"</strong>, or <strong>"Standard"</strong></p>
          </div>
        </div>
        <button type="button" class="btn-secondary" id="replayPreLoginVoiceBtn" style="min-height:38px; padding:6px 12px; font-size:.88rem;">🔊 Listen Again</button>
      </div>

      <!-- 5 Disability Decision Cards -->
      <div class="onboarding-cards-grid" style="grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));">
        <!-- 1. BLIND / NON-VISUAL -->
        <div class="onboarding-profile-card pre-login-card" data-profile="blind" role="button" tabindex="0" aria-label="Select Blind or Non-Visual Assistance Profile">
          <div>
            <div class="profile-badge">👁️ BLIND / NON-VISUAL</div>
            <h3 style="margin-top:6px;">Blind / Non-Visual</h3>
            <p>Full voice navigation without needing sight.</p>
            <ul class="profile-features-list">
              <li>🎙️ <strong>Continuous Hands-Free Voice Assistant</strong></li>
              <li>🔊 <strong>Full Text-to-Speech narration</strong></li>
              <li>🛡️ <strong>Two-Click Safe Mode</strong></li>
              <li>🔑 <strong>Decided Login Type:</strong> Voice Sign-In & Audio Code</li>
            </ul>
          </div>
          <button type="button" class="btn-primary select-pre-login-btn" data-profile="blind" style="width:100%; margin-top:12px;">
            🎙️ Choose Blind Profile (Say "Blind")
          </button>
        </div>

        <!-- 2. LOW VISION -->
        <div class="onboarding-profile-card pre-login-card" data-profile="low_vision" role="button" tabindex="0" aria-label="Select Low Vision and High Contrast Profile">
          <div>
            <div class="profile-badge">🔍 LOW VISION</div>
            <h3 style="margin-top:6px;">Low Vision & Partial Sight</h3>
            <p>Maximum visibility with enlarged fonts and contrast.</p>
            <ul class="profile-features-list">
              <li>🔠 <strong>A++ Maximum Text Scaling (125%)</strong></li>
              <li>👁️ <strong>AAA High Contrast (Yellow on Black)</strong></li>
              <li>🏷️ <strong>Highlighted Financial Data</strong></li>
              <li>🔑 <strong>Decided Login Type:</strong> Large High-Contrast Math Challenge</li>
            </ul>
          </div>
          <button type="button" class="btn-primary select-pre-login-btn" data-profile="low_vision" style="width:100%; margin-top:12px;">
            👁️ Choose Low Vision (Say "Low Vision")
          </button>
        </div>

        <!-- 3. MOTOR ASSISTANCE -->
        <div class="onboarding-profile-card pre-login-card" data-profile="motor" role="button" tabindex="0" aria-label="Select Motor and Tremor Assistance Profile">
          <div>
            <div class="profile-badge">🖐️ MOTOR ASSISTANCE</div>
            <h3 style="margin-top:6px;">Motor & Tremor Support</h3>
            <p>Designed for tremors, weakness, or limited hand dexterity.</p>
            <ul class="profile-features-list">
              <li>⏱️ <strong>Hover Select (Dwell Clicking 1.2s)</strong></li>
              <li>🛡️ <strong>Two-Click Safe Mode</strong></li>
              <li>⌨️ <strong>Large On-Screen Virtual Keyboard</strong></li>
              <li>🔑 <strong>Decided Login Type:</strong> 1-Tap Accessible Verification</li>
            </ul>
          </div>
          <button type="button" class="btn-primary select-pre-login-btn" data-profile="motor" style="width:100%; margin-top:12px;">
            🖐️ Choose Motor Profile (Say "Motor")
          </button>
        </div>

        <!-- 4. SENIOR CITIZEN -->
        <div class="onboarding-profile-card pre-login-card" data-profile="senior" role="button" tabindex="0" aria-label="Select Senior Citizen and Simplified Profile">
          <div>
            <div class="profile-badge">👵 SENIOR CITIZEN</div>
            <h3 style="margin-top:6px;">Senior Citizen & Relaxed</h3>
            <p>Stress-free banking with simple everyday terms.</p>
            <ul class="profile-features-list">
              <li>📖 <strong>Plain Everyday Words (No Jargon)</strong></li>
              <li>⏳ <strong>Zero Session Timeout Pressure</strong></li>
              <li>🐢 <strong>Reduced Motion & Smooth Flow</strong></li>
              <li>🔑 <strong>Decided Login Type:</strong> SMS One-Time Code (OTP)</li>
            </ul>
          </div>
          <button type="button" class="btn-primary select-pre-login-btn" data-profile="senior" style="width:100%; margin-top:12px;">
            👵 Choose Senior Profile (Say "Senior")
          </button>
        </div>
      </div>

      <!-- 5. STANDARD OPTION -->
      <div style="margin-top:20px; padding:16px; background:var(--bg); border:1px solid var(--border); border-radius:8px; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px;">
        <div>
          <strong style="color:var(--navy);">Standard Banking Experience:</strong>
          <div style="font-size:.88rem; color:var(--ink-soft);">Proceed with standard password login and clean modern theme.</div>
        </div>
        <button type="button" class="btn-secondary select-pre-login-btn" data-profile="standard" style="padding:8px 18px; font-weight:700;">
          ✨ Continue with Standard Mode (Say "Standard")
        </button>
      </div>
    </div>
  </main>

  <!-- LOGIN VIEW -->
  <main id="loginView" class="main-content" style="max-width:540px; margin:30px auto; display:none;" data-readable>
    <div class="panel">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
        <button type="button" id="backToAssessmentBtn" class="btn-secondary" style="padding:4px 10px; font-size:.85rem; font-weight:700;">
          ← Change Assistance Setup
        </button>
        <span id="activeLoginProfileBadge" style="font-size:.78rem; font-weight:800; background:var(--gold); color:var(--navy-dark); padding:3px 8px; border-radius:4px;">
          STANDARD
        </span>
      </div>

      <h1 data-i18n="loginHeading" data-standard="Sign in to your account" data-plain="Sign In to Your Money">Sign in to your account</h1>

      <!-- MODE SWITCHER: SIGN IN vs CREATE ACCOUNT -->
      <div style="display:flex; border:2px solid var(--border); border-radius:8px; overflow:hidden; margin:12px 0 16px 0;" role="tablist" aria-label="Account Access Mode">
        <button type="button" id="tabModeLogin" class="tab-btn" style="flex:1; padding:10px; font-weight:800; border-radius:0; border:none; background:var(--navy); color:#fff;" aria-selected="true">
          🔐 Sign In
        </button>
        <button type="button" id="tabModeRegister" class="tab-btn" style="flex:1; padding:10px; font-weight:800; border-radius:0; border:none; background:var(--surface); color:var(--ink);" aria-selected="false">
          📝 Create Account
        </button>
      </div>

      <!-- 1. LOGIN FORM CONTAINER -->
      <div id="loginFormContainer">
        <div class="pw-solution-box" role="region" aria-label="Password accessibility explanation">
          <strong data-i18n="pwSolutionTitle">♿ Accessible Password Support:</strong>
          <p style="margin:4px 0 8px 0; font-size:.88rem;" data-i18n="pwSolutionDesc">Pasting is strictly allowed. You can use password managers or assisted filling.</p>
          <button type="button" class="btn-secondary" id="autoFillDemoBtn" style="min-height:40px; padding:6px 14px; font-size:.9rem;">
            ⚡ <span data-i18n="autoFillBtn">1-Tap Fill Demo Credentials</span>
          </button>
        </div>

        <div class="tabs" role="tablist" aria-label="Sign-in method">
          <button class="tab-btn" role="tab" id="tabPassword" aria-selected="true" data-i18n="tabPassword">Standard Password</button>
          <button class="tab-btn" role="tab" id="tabOtp" aria-selected="false" data-i18n="tabOtp">One-Time Code (SMS)</button>
        </div>

        <div id="panelPassword" role="tabpanel">
          <div class="field">
            <label for="username" data-i18n="lblUsername">Username or Customer ID</label>
            <input type="text" id="username" autocomplete="username" value="asha.patel">
          </div>
          <div class="field">
            <label for="password" data-i18n="lblPassword">Password</label>
            <div class="pw-wrap">
              <input type="password" id="password" autocomplete="current-password" value="SahaaySafe2026!" onpaste="return true;">
              <button type="button" class="pw-toggle" id="pwToggle" aria-label="Show password in plain text" data-i18n="pwToggle">Show</button>
            </div>
          </div>
          <!-- ACCESSIBLE CAPTCHA VERIFICATION -->
          <div class="captcha-container" role="region" aria-label="Accessible Security Verification">
            <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:8px; margin-bottom:12px;">
              <label for="captchaTypeSelect" style="font-weight:700; font-size:.92rem;">🛡️ Choose Verification Type:</label>
              <select id="captchaTypeSelect" style="padding:6px 12px; font-size:.88rem; min-height:36px; border-radius:6px; border:2px solid var(--border); background:var(--surface); color:var(--ink); font-weight:600;">
                <option value="checkbox" selected>1. Accessible 1-Tap Checkbox</option>
                <option value="math">2. Simple Math Challenge</option>
                <option value="audio">3. Spoken Audio Voice Code</option>
              </select>
            </div>

            <!-- OPTION 1: 1-Tap Accessible Checkbox (SHOWS ALONE WHEN SELECTED) -->
            <div id="captchaCheckWrap" class="captcha-challenge-row" style="padding:12px; background:var(--bg); border-radius:6px; border:1.5px solid var(--border);">
              <label style="display:flex; align-items:center; gap:12px; cursor:pointer; font-weight:700;">
                <input type="checkbox" id="captchaCheckbox" style="width:24px; height:24px; cursor:pointer;" aria-label="Confirm you are an authorized human user">
                <span style="font-size:.95rem;">I confirm I am an authorized human user</span>
              </label>
            </div>

            <!-- OPTION 2: Simple Math Challenge (SHOWS ALONE WHEN SELECTED) -->
            <div id="captchaMathBox" class="captcha-challenge-row" style="padding:12px; background:var(--bg); border-radius:6px; border:1.5px solid var(--border);" hidden>
              <div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap;">
                <span class="captcha-badge" id="captchaQuestion" style="font-size:1.3rem; font-weight:900; padding:8px 18px; background:#0F172A !important; color:#FFD400 !important; border-radius:6px; border:2px solid #C29333; letter-spacing:2px; display:inline-block;">4 + 3 = ?</span>
                <input type="number" id="captchaInput" placeholder="Answer" style="max-width:110px; font-size:1.15rem; text-align:center; padding:6px; background:var(--surface); color:var(--ink); border:2px solid var(--border);" aria-label="Enter math answer">
                <button type="button" class="btn-secondary" id="listenCaptchaBtn" title="Hear math problem spoken aloud" style="min-height:38px; padding:6px 12px;">🔊 Listen</button>
                <button type="button" class="btn-secondary" id="refreshCaptchaBtn" title="Generate another math problem" style="min-height:38px; padding:6px 12px;">🔄</button>
              </div>
            </div>

            <!-- OPTION 3: Audio Voice Code (SHOWS ALONE WHEN SELECTED) -->
            <div id="captchaAudioBox" class="captcha-challenge-row" style="padding:12px; background:var(--bg); border-radius:6px; border:1.5px solid var(--border);" hidden>
              <div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap;">
                <button type="button" class="btn-secondary" id="playAudioCodeBtn" style="min-height:40px; padding:6px 14px; font-weight:700;">🔊 Play Audio Code</button>
                <input type="text" id="captchaAudioInput" maxlength="4" placeholder="4-digit code" style="max-width:140px; font-size:1.15rem; text-align:center; padding:6px; letter-spacing:4px;" aria-label="Enter 4-digit spoken audio code">
                <button type="button" class="btn-secondary" id="refreshAudioCodeBtn" title="Generate new audio code" style="min-height:38px; padding:6px 12px;">🔄</button>
              </div>
            </div>

            <div id="captchaError" class="field-error" style="margin-top:8px; color:var(--danger); font-weight:700;" hidden>⚠️ Verification required: Please complete the challenge before signing in.</div>
          </div>

          <button class="btn-primary" id="loginBtn" style="width:100%;" data-i18n="btnSignIn">Sign in to Dashboard</button>

          <!-- OPTION: LOGIN VIA FACE VERIFICATION (NO CREDENTIALS NEEDED) -->
          <div style="margin:16px 0 6px 0; text-align:center;">
            <div style="display:flex; align-items:center; gap:8px; margin-bottom:12px;">
              <hr style="flex:1; border:none; border-top:1px solid var(--border);">
              <span style="font-size:.78rem; font-weight:800; color:var(--ink-soft); text-transform:uppercase; letter-spacing:1px;">OR SIGN IN WITHOUT TYPING</span>
              <hr style="flex:1; border:none; border-top:1px solid var(--border);">
            </div>
            <button type="button" class="btn-primary" id="loginWithFaceBtn" style="width:100%; background:linear-gradient(135deg, #1E1B4B 0%, #312E81 50%, #4338CA 100%); border:2px solid #6366F1; font-size:1.05rem; padding:13px; display:flex; align-items:center; justify-content:center; gap:10px; box-shadow:0 4px 14px rgba(67,56,202,0.25);">
              <span style="font-size:1.3rem;">📸</span>
              <span><strong>Login via Face Verification</strong></span>
            </button>
            <p style="font-size:.82rem; color:var(--ink-soft); margin:8px 0 0 0;">
              No passwords or typing required. Automatically recognizes your face and signs in.
            </p>
          </div>
        </div>
      </div>

      <!-- 2. CREATE ACCOUNT / REGISTER FORM CONTAINER -->
      <div id="registerFormContainer" hidden>
        <h2 style="font-size:1.2rem; margin:0 0 6px 0;">Create Demo Banking Account</h2>
        <p style="font-size:.88rem; color:var(--ink-soft); margin:0 0 16px 0;">Open an accessible demo account instantly. Transfers between users are fully active.</p>

        <form id="registrationForm" onsubmit="event.preventDefault();">
          <div class="field">
            <label for="regFullName">Full Name *</label>
            <input type="text" id="regFullName" placeholder="e.g. Ramesh Chandra" required autocomplete="name">
          </div>

          <div class="field">
            <label for="regUsername">Username * (letters, numbers, periods)</label>
            <input type="text" id="regUsername" placeholder="e.g. ramesh.chandra" required autocomplete="username">
            <p class="field-hint" style="margin-top:4px;">UPI ID: <strong id="regPreviewUpiId" style="color:var(--navy);">username@sahaay</strong></p>
          </div>

          <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px;">
            <div class="field">
              <label for="regPassword">Password *</label>
              <div class="pw-wrap">
                <input type="password" id="regPassword" placeholder="Min 6 chars" required autocomplete="new-password">
                <button type="button" class="pw-toggle" id="regPwToggle">Show</button>
              </div>
