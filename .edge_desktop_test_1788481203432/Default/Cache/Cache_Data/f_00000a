/**
 * Sahaay Bank Main Application Bootstrap & Coordinator
 */
window.SahaayApp = (function(){
  'use strict';

  let currentSection = 'overview';
  let isFrozen = false;
  let sessionTimer = null;
  let sessionSeconds = 15 * 60; // 900 seconds (Real 15 minutes)
  let timeoutDisabled = false;
  let hideBalanceByDefault = true;
  let isBalanceVisible = false;
  let mainBalance = 42180.50;
  let currentTxList = [];
  let currentTxFilter = 'ALL';
  let currentTransferPaymentMethod = 'UPI';
  let pendingTransferExecution = null;
  let currentMobileView = 'home';
  let switchMobileView = function(viewName) {};

  function renderTransactions(txList = null, filter = null) {
    if (txList) currentTxList = txList;
    if (filter) currentTxFilter = filter.toUpperCase();

    const tbody = document.getElementById('transactionTbody');
    if (!tbody) return;

    let items = currentTxList || [];

    if (currentTxFilter !== 'ALL') {
      items = items.filter(tx => {
        const type = (tx.type || '').toUpperCase();
        const dir = (tx.direction || '').toUpperCase();
        const method = (tx.paymentMethod || '').toUpperCase();
        const tag = (tx.tag || '').toUpperCase();

        if (currentTxFilter === 'SENT') {
          return dir === 'DEBIT' || type === 'TRANSFER_SENT' || type === 'DEBIT';
        }
        if (currentTxFilter === 'RECEIVED') {
          return dir === 'CREDIT' || type === 'TRANSFER_RECEIVED' || type === 'CREDIT';
        }
        if (currentTxFilter === 'QR') {
          return method === 'QR' || type === 'QR_PAYMENT' || tag === 'QR';
        }
        if (currentTxFilter === 'UPI') {
          return method === 'UPI' || type === 'UPI_PAYMENT' || (tag !== 'DEPOSIT' && method !== 'QR');
        }
        if (currentTxFilter === 'DEPOSIT') {
          return type === 'DEPOSIT' || tag === 'DEPOSIT';
        }
        if (currentTxFilter === 'REFUND') {
          return type === 'REFUND' || tag === 'REFUND';
        }
        return true;
      });
    }

    document.querySelectorAll('.tx-filter-btn').forEach(btn => {
      const f = btn.dataset.filter?.toUpperCase();
      btn.classList.toggle('active', f === currentTxFilter);
    });

    if (items.length === 0) {
      tbody.innerHTML = `<tr><td colspan="5" style="text-align:center; padding:24px; color:var(--ink-soft);">No transactions found for this filter.</td></tr>`;
      return;
    }

    tbody.innerHTML = items.map(tx => {
      const isCredit = (
        (tx.direction && tx.direction.toUpperCase() === 'CREDIT') ||
        tx.type === 'TRANSFER_RECEIVED' ||
        tx.type === 'Credit' ||
        tx.type === 'DEPOSIT' ||
        tx.tag === 'DEPOSIT' ||
        (tx.description && tx.description.toLowerCase().includes('from ')) ||
        (tx.description && tx.description.toLowerCase().includes('credit'))
      );
      const isDebit = !isCredit;
      const amtNum = Number(tx.amount || 0);

      let typeBadge = '';
      const isQr = (tx.paymentMethod === 'QR' || tx.type === 'QR_PAYMENT' || tx.tag === 'QR');
      if (isQr) {
        if (isCredit) {
          typeBadge = `<span class="qr-badge-pill qr-badge-qr" style="background:rgba(16,185,129,0.12); color:#059669;">📱 QR Received</span>`;
        } else {
          typeBadge = `<span class="qr-badge-pill qr-badge-qr">📱 QR Payment</span>`;
        }
      } else if (tx.type === 'DEPOSIT' || tx.tag === 'DEPOSIT') {
        typeBadge = `<span class="qr-badge-pill qr-badge-dep">➕ Demo Deposit</span>`;
      } else if (isCredit) {
        typeBadge = `<span class="qr-badge-pill" style="background:rgba(16,185,129,0.12); color:#059669;">↙️ Money Received</span>`;
      } else {
        typeBadge = `<span class="qr-badge-pill" style="background:rgba(239,68,68,0.12); color:#DC2626;">↗️ Money Sent</span>`;
      }

      let metaHtml = '';
      if (tx.reasonCategory) {
        metaHtml += `<div style="font-size:.8rem; color:var(--ink-soft); margin-top:3px;">📌 Reason: <strong>${tx.reasonCategory}</strong>${tx.reasonText ? ' — ' + tx.reasonText : ''}</div>`;
      }
      if (tx.referenceId) {
        metaHtml += `<div style="font-size:.74rem; font-family:monospace; color:var(--ink-soft); margin-top:2px;">Ref: ${tx.referenceId}</div>`;
      }

      let amtHtml = '';
      if (isCredit) {
        amtHtml = `<td class="amt credit" style="color:#059669 !important; font-weight:700;">+ ₹${amtNum.toLocaleString('en-IN', { minimumFractionDigits: 2 })} <span style="font-size:.72rem; display:block; color:#059669; font-weight:800;">CREDIT</span></td>`;
      } else {
        amtHtml = `<td class="amt debit" style="color:#DC2626 !important; font-weight:700;">− ₹${amtNum.toLocaleString('en-IN', { minimumFractionDigits: 2 })} <span style="font-size:.72rem; display:block; color:#DC2626; font-weight:800;">DEBIT</span></td>`;
      }

      const balVal = (tx.balanceAfter !== undefined && tx.balanceAfter !== null)
        ? `₹ ${Number(tx.balanceAfter).toLocaleString('en-IN', { minimumFractionDigits: 2 })}`
        : '—';
      const balHtml = `<td style="font-weight:700; color:var(--navy);">${balVal}</td>`;

      return `
        <tr>
          <td>${tx.date || 'Today'}</td>
          <td>
            <strong>${tx.counterpartyName || tx.counterparty || tx.description || 'Transfer'}</strong>
            ${tx.counterpartyUpiId ? `<div style="font-size:.82rem; color:var(--ink-soft);">${tx.counterpartyUpiId}</div>` : ''}
            ${metaHtml}
          </td>
          <td>${typeBadge}</td>
          ${amtHtml}
          ${balHtml}
        </tr>
      `;
    }).join('');

    const mobileFeed = document.getElementById('mobileTxFeedList');
    if (mobileFeed) {
      const topTxs = (items || []).slice(0, 5);
      if (topTxs.length === 0) {
        mobileFeed.innerHTML = '<div style="padding:16px; text-align:center; color:#A5BCC8; font-size:.88rem;">No transactions yet.</div>';
      } else {
        mobileFeed.innerHTML = topTxs.map(tx => {
          const type = (tx.type || '').toUpperCase();
          const dir = (tx.direction || '').toUpperCase();
          const isCredit = dir === 'CREDIT' || type.includes('RECEIVED') || type === 'DEPOSIT';
          const counterparty = tx.counterpartyName || tx.counterparty || tx.description || (isCredit ? 'Credit' : 'Debit');
          const amt = Number(tx.amount || 0).toLocaleString('en-IN', { minimumFractionDigits: 2 });
          const bal = (tx.balanceAfter !== undefined && tx.balanceAfter !== null) ? `Bal: ₹${Number(tx.balanceAfter).toLocaleString('en-IN')}` : '';
          const tagClass = type === 'DEPOSIT' ? 'tag-deposit' : (isCredit ? 'tag-received' : 'tag-sent');
          const tagLabel = type === 'DEPOSIT' ? 'DEPOSIT' : (isCredit ? 'RECEIVED' : 'SENT');

          return `
            <div class="mobile-tx-item">
              <div class="mobile-tx-left">
                <div class="mobile-tx-icon-circle ${isCredit ? 'icon-credit' : 'icon-debit'}">
                  ${isCredit ? '↙️' : '↗️'}
                </div>
                <div class="mobile-tx-details">
                  <div class="mobile-tx-title">${counterparty}</div>
                  <div class="mobile-tx-meta">
                    <span>${tx.date || 'Today'}</span>
                    <span class="mobile-tx-type-tag ${tagClass}">${tagLabel}</span>
                  </div>
                </div>
              </div>
              <div class="mobile-tx-right">
                <div class="mobile-tx-amount ${isCredit ? 'amount-credit' : 'amount-debit'}">
                  ${isCredit ? '+' : '-'} ₹${amt}
                </div>
                <div class="mobile-tx-bal-after">${bal}</div>
              </div>
            </div>
          `;
        }).join('');
      }
    }

    const mobileFullList = document.getElementById('mobileFullTxList');
    if (mobileFullList) {
      if ((items || []).length === 0) {
        mobileFullList.innerHTML = '<div style="padding:28px; text-align:center; color:#A5BCC8; font-size:.92rem;">No transactions found for this category.</div>';
      } else {
        mobileFullList.innerHTML = items.map(tx => {
          const type = (tx.type || '').toUpperCase();
          const dir = (tx.direction || '').toUpperCase();
          const isCredit = dir === 'CREDIT' || type.includes('RECEIVED') || type === 'DEPOSIT';
          const counterparty = tx.counterpartyName || tx.counterparty || tx.description || (isCredit ? 'Credit' : 'Debit');
          const amt = Number(tx.amount || 0).toLocaleString('en-IN', { minimumFractionDigits: 2 });
          const bal = (tx.balanceAfter !== undefined && tx.balanceAfter !== null) ? `Bal: ₹${Number(tx.balanceAfter).toLocaleString('en-IN')}` : '';
          const tagClass = type === 'DEPOSIT' ? 'tag-deposit' : (isCredit ? 'tag-received' : 'tag-sent');
          const tagLabel = type === 'DEPOSIT' ? 'DEPOSIT' : (isCredit ? 'RECEIVED' : 'SENT');

          return `
            <div class="mobile-tx-item" style="cursor:pointer;" onclick="window.SahaayApp && window.SahaayApp.showTxReceipt && window.SahaayApp.showTxReceipt('${tx.id || ''}')">
              <div class="mobile-tx-left">
                <div class="mobile-tx-icon-circle ${isCredit ? 'icon-credit' : 'icon-debit'}">
                  ${isCredit ? '↙️' : '↗️'}
                </div>
                <div class="mobile-tx-details">
                  <div class="mobile-tx-title">${counterparty}</div>
                  <div class="mobile-tx-meta">
                    <span>${tx.date || 'Today'}</span>
                    <span class="mobile-tx-type-tag ${tagClass}">${tagLabel}</span>
                    ${tx.referenceId ? `<span style="font-family:monospace; font-size:0.72rem; color:#A5BCC8;">Ref: ${tx.referenceId.slice(-6)}</span>` : ''}
                  </div>
                </div>
              </div>
              <div class="mobile-tx-right">
                <div class="mobile-tx-amount ${isCredit ? 'amount-credit' : 'amount-debit'}">
                  ${isCredit ? '+' : '-'} ₹${amt}
                </div>
                <div class="mobile-tx-bal-after">${bal}</div>
              </div>
            </div>
          `;
        }).join('');
      }
    }
  }

  async function loadTransactions(filter = null) {
    const txRes = await window.SahaayAPI.getTransactions();
    if (txRes && txRes.success && txRes.data) {
      renderTransactions(txRes.data, filter || currentTxFilter);
    }
  }

  function refreshAccountBalance(newBalance) {
    if (newBalance !== undefined && newBalance !== null) {
      mainBalance = Number(newBalance);
      const balEl = document.getElementById('mainBalanceText');
      if (balEl) {
        balEl.dataset.real = `₹ ${mainBalance.toLocaleString('en-IN', { minimumFractionDigits: 2 })}`;
      }
      updateBalanceDisplay();
      const curr = window.SahaayAPI.getCurrentUser();
      if (curr) curr.balance = mainBalance;
    }
  }

  function prepareTransfer(upiId, amount = null, method = 'QR') {
    currentTransferPaymentMethod = method;
    navigateTo('transfer');

    const payeeInput = document.getElementById('payee');
    if (payeeInput) payeeInput.value = upiId;

    const amtInput = document.getElementById('amount');
    if (amtInput && amount && Number(amount) > 0) {
      amtInput.value = amount;
    }

    const mobPayee = document.getElementById('mobilePayeeInput');
    if (mobPayee) mobPayee.value = upiId;
    const mobAmt = document.getElementById('mobileAmountInput');
    if (mobAmt && amount && Number(amount) > 0) mobAmt.value = amount;

    window.SahaayAPI.lookupUser(upiId).then(res => {
      if (res && res.success && res.user) {
        const preview = document.getElementById('recipientPreviewCard');
        const nameEl = document.getElementById('previewPayeeName');
        const upiEl = document.getElementById('previewPayeeUpi');
        if (nameEl) nameEl.textContent = `${res.user.name} (${method === 'QR' ? 'QR Scanned' : 'Verified'})`;
        if (upiEl) upiEl.textContent = `${res.user.upiId} • ${res.user.accountNumberMasked}`;
        if (preview) preview.style.display = 'block';

        const mobCard = document.getElementById('mobileVerifiedPayeeCard');
        const mobName = document.getElementById('mobileVerifiedName');
        const mobUpi = document.getElementById('mobileVerifiedUpi');
        if (mobCard && mobName && mobUpi) {
          mobName.textContent = `${res.user.name} (${method === 'QR' ? 'QR Scanned' : 'Verified'})`;
          mobUpi.textContent = res.user.upiId;
          mobCard.hidden = false;
        }
      }
    });

    setTimeout(() => {
      const amtElem = document.getElementById('amount');
      if (amtElem) {
        amtElem.focus();
        amtElem.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    }, 250);

    window.SahaayVoice?.announce(`Transfer to ${upiId} prepared via ${method}. Please enter amount.`, true);
  }

  function updateBalanceDisplay(){
    const balEl = document.getElementById('mainBalanceText');
    const toggleBtnText = document.getElementById('toggleBalanceText');
    if(!balEl) return;
    const realBal = balEl.dataset.real || '₹ 42,180.50';
    if(isBalanceVisible){
      balEl.innerHTML = `${realBal} <span class="smart-tag" style="${document.documentElement.classList.contains('highlight-info') ? 'display:inline-block;' : 'display:none;'}">[AVAILABLE]</span>`;
      if(toggleBtnText) toggleBtnText.textContent = 'Hide Balance';
    } else {
      balEl.innerHTML = `₹ •••••• <span class="smart-tag" style="display:none;">[AVAILABLE]</span>`;
      if(toggleBtnText) toggleBtnText.textContent = 'Show Balance';
    }

    const mobileBal = document.getElementById('mobileCardBalance');
    if (mobileBal) {
      mobileBal.textContent = isBalanceVisible ? realBal : '₹ ••••••';
    }
    const mobilePassBal = document.getElementById('mobilePassbookBalance');
    if (mobilePassBal) {
      mobilePassBal.textContent = isBalanceVisible ? realBal : '₹ ••••••';
    }
    const mobileTransferBal = document.getElementById('mobileTransferAvailBal');
    if (mobileTransferBal) {
      mobileTransferBal.textContent = isBalanceVisible ? realBal : '₹ ••••••';
    }
  }

  function showToast(msg){
    const t = document.getElementById('toast');
    if(!t) return;
    t.textContent = msg;
    t.classList.add('show');
    clearTimeout(t._timer);
    t._timer = setTimeout(() => t.classList.remove('show'), 3800);
  }

  function syncSettingsControls() {
    const hideBalChk = document.getElementById('cfg-hide-balance');
    if (hideBalChk) hideBalChk.checked = hideBalanceByDefault;
    const chkExplore = document.getElementById('cfg-explore');
    if (chkExplore && window.SahaayA11y?.isTwoClickSafe) chkExplore.checked = window.SahaayA11y.isTwoClickSafe();
    const chkRead = document.getElementById('cfg-click-read');
    if (chkRead && window.SahaayA11y?.isClickRead) chkRead.checked = window.SahaayA11y.isClickRead();
    const chkVoiceAlerts = document.getElementById('cfg-voice-alerts');
    if (chkVoiceAlerts && window.SahaayVoice?.isVoiceOutputEnabled) chkVoiceAlerts.checked = window.SahaayVoice.isVoiceOutputEnabled();
  }

  function navigateTo(sectionId){
    currentSection = sectionId;
    if(sectionId === 'settings') syncSettingsControls();
    const navItems = document.querySelectorAll('.nav-item[data-section]');
    navItems.forEach(b => {
      if(b.dataset.section === sectionId) b.setAttribute('aria-current', 'page');
      else b.removeAttribute('aria-current');
    });

    const sections = {
      overview: document.getElementById('section-overview'),
      transactions: document.getElementById('section-transactions'),
      transfer: document.getElementById('section-transfer'),
      help: document.getElementById('section-help'),
      settings: document.getElementById('section-settings')
    };

    Object.entries(sections).forEach(([key, sec])=>{
      if(sec) sec.hidden = (key !== sectionId);
    });

    // Mobile App View synchronization
    const isMobileMode = document.body.classList.contains('is-mobile-app') || window.innerWidth <= 820;
    const mobileDash = document.getElementById('mobileDashboardView');
    const mainContent = document.getElementById('main-content');
    if (isMobileMode) {
      if (mobileDash) mobileDash.style.display = 'block';
      if (mainContent) mainContent.style.display = 'none';

      if (sectionId === 'overview') switchMobileView('home');
      else if (sectionId === 'transfer') switchMobileView('transfer');
      else if (sectionId === 'transactions') switchMobileView('transactions');
      else if (sectionId === 'help') switchMobileView('ai');
      return;
    }

    if (mobileDash) {
      if (sectionId === 'overview') {
        mobileDash.style.display = 'block';
      } else {
        mobileDash.style.display = 'none';
        if (mainContent) mainContent.style.display = 'block';
      }
    }

    // Sync Bottom Nav tabs
    document.querySelectorAll('.bottom-nav-tab').forEach(t => t.classList.remove('active'));
    if (sectionId === 'overview') document.getElementById('bottomTabHome')?.classList.add('active');
    else if (sectionId === 'transfer') document.getElementById('bottomTabSend')?.classList.add('active');
    else if (sectionId === 'transactions') document.getElementById('bottomTabHistory')?.classList.add('active');

    document.getElementById('main-content')?.focus();
  }

  
  function updateMobileUserProfile(user) {
    if (!user) return;
    const name = user.name || user.accountHolder || 'Asha Patel';
    const acc = user.accountNumber ? user.accountNumber.toString() : '4417';
    const maskedAcc = '•••• ' + (acc.length >= 4 ? acc.slice(-4) : acc);
    const upi = user.upiId || 'asha.patel@sahaay';
    const initials = name.split(' ').map(p => p[0]).join('').slice(0, 2).toUpperCase() || 'SB';

    const avatarEl = document.getElementById('drawerAvatar');
    if (avatarEl) avatarEl.textContent = initials;
    const drawerName = document.getElementById('drawerUserName');
    if (drawerName) drawerName.textContent = name;
    const drawerUpi = document.getElementById('drawerUserUpi');
    if (drawerUpi) drawerUpi.textContent = upi;

    const cardHolder = document.getElementById('mobileCardHolderName');
    if (cardHolder) cardHolder.textContent = name;
    const cardAcc = document.getElementById('mobileCardAccNum');
    if (cardAcc) cardAcc.textContent = maskedAcc;

    const freezeBtn = document.getElementById('freezeBtn');
    const isFrozenNow = freezeBtn ? freezeBtn.getAttribute('aria-pressed') === 'true' : false;
    const freezeLabel = document.getElementById('drawerFreezeLabel');
    if (freezeLabel) freezeLabel.textContent = isFrozenNow ? 'Unfreeze Account' : 'Freeze Account';
    const chipFreezeLabel = document.getElementById('mobileChipFreezeLabel');
    if (chipFreezeLabel) chipFreezeLabel.textContent = isFrozenNow ? 'Unlock' : 'Lock';
  }

  function resetMobileUserProfile() {
    const avatarEl = document.getElementById('drawerAvatar');
    if (avatarEl) avatarEl.textContent = '👤';
    const drawerName = document.getElementById('drawerUserName');
    if (drawerName) drawerName.textContent = 'Guest User';
    const drawerUpi = document.getElementById('drawerUserUpi');
    if (drawerUpi) drawerUpi.textContent = 'guest@sahaay';
  }

  async function enterDashboard(userData) {
    const loginView = document.getElementById('loginView');
    const assessView = document.getElementById('accessibilityAssessmentView');
    if (loginView) {
      loginView.hidden = true;
      loginView.style.display = 'none';
    }
    if (assessView) {
      assessView.style.display = 'none';
    }
    document.getElementById('dashboardView').hidden = false;

    // Resolve active account data
    let user = userData || window.SahaayAPI.getCurrentUser();
    if (!user) {
      const accRes = await window.SahaayAPI.getAccount();
      if (accRes && accRes.success) user = accRes.data;
    }

    if (user) {
      // 1. Update Welcome Greeting
      const welcomeH1 = document.querySelector('#section-overview h1[data-standard]');
      if (welcomeH1) {
        const uName = user.name || user.accountHolder || 'User';
        welcomeH1.textContent = `Welcome back, ${uName}`;
        welcomeH1.dataset.standard = `Welcome back, ${uName}`;
        welcomeH1.dataset.plain = `Hello ${uName}! Here is your money summary:`;
      }

      // 2. Update Account & UPI Subtext
      const balSub = document.querySelector('#section-overview .field-hint[data-i18n="balanceSubText"]');
      if (balSub) {
        const accNum = user.accountNumber || '4417';
        const upi = user.upiId || 'asha.patel@sahaay';
        balSub.innerHTML = `Savings Account ending in <strong>${accNum}</strong> <span class="smart-tag" style="display:none;">[ACC: ${accNum}]</span> • UPI ID: <strong>${upi}</strong> <span class="smart-tag" style="display:none;">[UPI]</span>`;
      }

      // 3. Update Balance
      if (user.balance !== undefined) {
        mainBalance = Number(user.balance);
        const balEl = document.getElementById('mainBalanceText');
        if (balEl) balEl.dataset.real = `₹ ${mainBalance.toLocaleString('en-IN', { minimumFractionDigits: 2 })}`;
        updateBalanceDisplay();
      }

      // 4. Load User-Specific Transactions
      const txRes = await window.SahaayAPI.getTransactions();
      if (txRes && txRes.success && txRes.data) {
        renderTransactions(txRes.data);
      }

      // 5. Render User's Specific QR Code
      if (window.SahaayQr && window.SahaayQr.renderQr) {
        window.SahaayQr.renderQr();
      }

      // 6. Set enrolled template for face verification if present
      if (user.faceVerification && user.faceVerification.template) {
        window.SahaayFace?.setEnrolledTemplate(user.faceVerification.template);
      }
    }

    updateMobileUserProfile(user);
    navigateTo('overview');
    startSessionTimer();
    window.SahaayVoice.announce(`Signed in as ${user?.name || 'User'}. Showing your account overview.`, true);
  }

  function signOut() {
    window.SahaayAPI.logout();
    resetMobileUserProfile();
    document.getElementById('dashboardView').hidden = true;
    const loginView = document.getElementById('loginView');
    if (loginView) {
      loginView.hidden = true;
      loginView.style.display = 'none';
    }
    const assessView = document.getElementById('accessibilityAssessmentView');
    if (assessView) {
      assessView.style.display = 'block';
      assessView.scrollIntoView({ behavior: 'smooth' });
    }
    clearInterval(sessionTimer);
    window.SahaayVoice.announce('You have signed out securely.');
    window.SahaayVoice.speakText('You have signed out securely. Returned to accessibility setup.');
  }

  function startSessionTimer(){
    if(timeoutDisabled) return;
    clearInterval(sessionTimer);
    sessionSeconds = 15 * 60; // 15 real minutes
    const banner = document.getElementById('timeoutBanner');
    if(banner){
      banner.classList.remove('show');
      banner.style.display = 'none';
    }
    sessionTimer = setInterval(()=>{
      if(timeoutDisabled) return;
      sessionSeconds--;
      if(sessionSeconds <= 60 && sessionSeconds > 0){
        if(banner){
          banner.classList.add('show');
          banner.style.display = 'flex';
        }
        window.SahaayVoice.announce('Warning: 1 minute remaining in your 15-minute secure session. Tap Add 15 Minutes to extend.', true);
      }
    }, 1000);
  }

  function toggleAccountFreeze(){
    isFrozen = !isFrozen;
    const bar = document.getElementById('freezeBar');
    const btn = document.getElementById('freezeBtn');
    const statusText = document.getElementById('freezeStatusText');
    const subText = document.getElementById('freezeSubText');

    bar?.classList.toggle('frozen', isFrozen);
    btn?.setAttribute('aria-pressed', isFrozen);
    if(btn) btn.textContent = isFrozen ? '✓ Unfreeze my account' : '🛑 Freeze my account now';
    if(statusText) statusText.textContent = isFrozen ? 'Your account is FROZEN — all transactions stopped' : 'Your account is active';
    if(subText) subText.textContent = isFrozen ? 'No money can move out right now. Tap unfreeze whenever ready.' : 'One tap stops all card and transfer activity immediately.';

    window.SahaayAPI.toggleFreeze(isFrozen);

    const alertMsg = isFrozen
      ? 'EMERGENCY ALERT: Your account is now FROZEN. All card transactions and transfers are blocked.'
      : 'Your account has been unfrozen. Normal banking operations are active.';

    showToast(isFrozen ? 'Account Frozen' : 'Account Active');
    window.SahaayVoice.announce(alertMsg, true);
  }

  function runA11yAudit(){
    const results = [];
    const unlabelledButtons = Array.from(document.querySelectorAll('button')).filter(b => !b.innerText.trim() && !b.getAttribute('aria-label') && !b.getAttribute('title'));
    results.push({
      test: 'Interactive Button Accessible Names (WCAG 4.1.2)',
      status: unlabelledButtons.length === 0,
      desc: unlabelledButtons.length === 0 ? 'All buttons have distinct accessible labels.' : `${unlabelledButtons.length} unlabelled buttons found.`
    });

    results.push({
