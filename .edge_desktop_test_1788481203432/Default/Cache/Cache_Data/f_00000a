        showToast('Invalid Payee');
        window.SahaayVoice.announce('Cannot send money: Please select or enter a valid recipient.', true);
        return;
      }
      document.getElementById('payee')?.classList.remove('has-error');
      if (payeeError) payeeError.hidden = true;

      const amt = Number(document.getElementById('amount')?.value);
      if (isNaN(amt) || amt <= 0) {
        document.getElementById('amount')?.classList.add('has-error');
        document.getElementById('amountError').hidden = false;
        return;
      }
      if (amt > mainBalance) {
        document.getElementById('amount')?.classList.add('has-error');
        const amtErr = document.getElementById('amountError');
        if (amtErr) {
          amtErr.hidden = false;
          amtErr.textContent = `⚠️ Insufficient balance: Available demo balance is ₹${mainBalance.toLocaleString('en-IN', { minimumFractionDigits: 2 })}.`;
