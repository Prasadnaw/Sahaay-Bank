        showToast('Insufficient Balance');
        window.SahaayVoice.announce('Insufficient demo balance.', true);
        return;
      }
      document.getElementById('amount')?.classList.remove('has-error');
      document.getElementById('amountError').hidden = true;

      const reason = document.getElementById('transferReason')?.value.trim() || '';
      const authMethod = document.querySelector('input[name="transferAuthMethod"]:checked')?.value || 'pin';

      // Demo Risk Threshold Check (₹10,000+)
      if (amt >= 10000) {
        let riskScore = 25; // Base high value >= 10,000
        const isPastRecipient = (currentTxList || []).some(t =>
          (t.counterpartyUpiId && t.counterpartyUpiId.toLowerCase() === resolvedPayee.toLowerCase()) ||
          (t.counterparty && t.counterparty.toLowerCase().includes(resolvedPayee.toLowerCase()))
        );
        if (!isPastRecipient) riskScore += 20;
        if (amt > (mainBalance * 0.5)) riskScore += 20;

        let riskLevel = 'LOW RISK';
        let riskBg = '#DEF7EC';
        let riskColor = '#03543F';
        if (riskScore >= 60) {
          riskLevel = 'HIGH RISK';
          riskBg = '#FDE8E8';
          riskColor = '#9B1C1C';
        } else if (riskScore >= 30) {
          riskLevel = 'MEDIUM RISK';
          riskBg = '#FEF3C7';
          riskColor = '#B45309';
        }

        const riskBadge = document.getElementById('demoRiskScoreBadge');
        if (riskBadge) {
          riskBadge.textContent = `${riskLevel} (+${riskScore})`;
          riskBadge.style.background = riskBg;
          riskBadge.style.color = riskColor;
        }

        pendingTransferExecution = {
          payee: resolvedPayee,
          amount: amt,
          authMethod,
          paymentMethod: currentTransferPaymentMethod,
          note: reason
        };

        const reasonModal = document.getElementById('transferReasonModal');
        if (reasonModal) {
          reasonModal.classList.add('open');
          window.SahaayVoice?.announce(
            'Additional verification: This transfer requires a reason because it exceeds Sahaay\'s demo risk threshold.',
            true
          );
        }
        return;
      }

      // Normal flow under ₹10,000
      window.SahaayUpi.initiateTransfer(
        resolvedPayee,
        amt,
        reason,
        authMethod,
        currentTransferPaymentMethod,
        null,
        null
      );
    });

