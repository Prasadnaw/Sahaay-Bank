    async function renderMobileQrScreen() {
      const wrap = document.getElementById('mobileMyQrCanvasWrap');
      if (!wrap) return;
      const currentUser = window.SahaayAPI?.getCurrentUser() || null;
      const upiId = currentUser?.upiId || 'asha.patel@sahaay';
      const name = currentUser?.name || 'Asha Patel';

      const nameEl = document.getElementById('mobileMyQrName');
      const upiEl = document.getElementById('mobileMyQrUpiText');
      const avatarEl = document.getElementById('mobileMyQrAvatar');
      if (nameEl) nameEl.textContent = name;
      if (upiEl) upiEl.textContent = upiId;
      if (avatarEl) avatarEl.textContent = name.split(' ').map(p => p[0]).join('').slice(0, 2).toUpperCase() || 'AP';

      const upiUri = `upi://pay?pa=${encodeURIComponent(upiId)}&pn=${encodeURIComponent(name)}&mc=0000&mode=02&purpose=00`;

      if (window.QRCode && window.QRCode.toCanvas) {
        wrap.innerHTML = '';
        const canvas = document.createElement('canvas');
        try {
          await window.QRCode.toCanvas(canvas, upiUri, {
            width: 220,
            margin: 2,
            color: { dark: '#0F172A', light: '#FFFFFF' }
          });
          wrap.appendChild(canvas);
          return;
        } catch (e) {
          console.warn('Mobile QR render error:', e);
        }
      }
    }

    document.getElementById('mobileMyQrCopyBtn')?.addEventListener('click', () => {
      const upiText = document.getElementById('mobileMyQrUpiText')?.textContent || 'asha.patel@sahaay';
      navigator.clipboard?.writeText(upiText).then(() => {
        showToast('✓ UPI ID Copied: ' + upiText);
        window.AndroidBridge?.vibrate?.(20);
      });
    });

    document.getElementById('mobileSaveQrToGalleryBtn')?.addEventListener('click', () => {
      const canvas = document.querySelector('#mobileMyQrCanvasWrap canvas');
      if (canvas) {
        const dataUrl = canvas.toDataURL('image/png');
        if (window.AndroidBridge && window.AndroidBridge.saveQrToGallery) {
          window.AndroidBridge.saveQrToGallery(dataUrl, 'Sahaay_UPI_QR.png');
        } else {
          const a = document.createElement('a');
          a.href = dataUrl;
          a.download = 'Sahaay_UPI_QR.png';
          a.click();
          showToast('✓ QR Code Saved to Downloads!');
        }
      }
    });

    const shareMobileQr = () => {
      const upiText = document.getElementById('mobileMyQrUpiText')?.textContent || 'asha.patel@sahaay';
      if (navigator.share) {
        navigator.share({
          title: 'Pay via Sahaay UPI',
          text: `Pay Asha Patel on Sahaay UPI: ${upiText}`,
          url: window.location.href
        }).catch(() => {});
      } else {
        navigator.clipboard?.writeText(`upi://pay?pa=${upiText}&pn=Asha%20Patel`);
        showToast('✓ UPI payment link copied to clipboard!');
      }
    };
    document.getElementById('mobileMyQrShareHeaderBtn')?.addEventListener('click', shareMobileQr);
    document.getElementById('mobileShareQrDirectBtn')?.addEventListener('click', shareMobileQr);

    // -------------------------------------------------------------
    // SCREEN 5: MOBILE AI ASSISTANT CONTROLS
    // -------------------------------------------------------------
    const appendMobileAiMsg = (text, isUser = false) => {
      const feed = document.getElementById('mobileAiChatFeed');
      if (!feed) return;
      const div = document.createElement('div');
      div.className = `mobile-chat-bubble ${isUser ? 'user' : 'assistant'}`;
      div.innerHTML = `
        <div class="mobile-bubble-sender">${isUser ? '👤 You' : '🤖 Sahaay AI Companion'}</div>
        <div class="mobile-bubble-text">${text}</div>
      `;
      feed.appendChild(div);
      feed.scrollTop = feed.scrollHeight;
    };

    const handleMobileAiQuery = (query) => {
      if (!query || !query.trim()) return;
      const q = query.trim();
      appendMobileAiMsg(q, true);

      const lang = window.SahaayVoice ? window.SahaayVoice.detectLanguage(q) : 'en-IN';

      setTimeout(() => {
        let answer = '';
        const lower = q.toLowerCase();

        if (/\b(balance|बैलेंस|kitna|rupaye|money|available)\b/i.test(lower)) {
          const bal = `₹ ${mainBalance.toLocaleString('en-IN', { minimumFractionDigits: 2 })}`;
          answer = lang === 'hi-IN'
            ? `आपका वर्तमान उपलब्ध बैलेंस ${bal} है। खाता संख्या 4417 सुरक्षित है।`
            : `Your current available balance is ${bal} in your Savings Account ending in 4417.`;
        } else if (/\b(transaction|statement|history|passbook|len den)\b/i.test(lower)) {
          answer = lang === 'hi-IN'
            ? 'आपके हाल के लेन-देन पासबुक में उपलब्ध हैं। आप नीचे "📜 Passbook" बटन पर टैप कर सकते हैं।'
            : 'You have 3 recent transactions: ₹15,000 Salary Credit, ₹1,240 Electricity Bill, and ₹180 Chai Point.';
        } else if (/\b(send|transfer|bhejo|pay)\b/i.test(lower)) {
          answer = lang === 'hi-IN'
            ? 'पैसे भेजने के लिए नीचे "💸 Transfer" टैब पर क्लिक करें।'
            : 'You can tap the Transfer tab below to quickly send money to any registered user or UPI ID.';
        } else if (/\b(freeze|lock|रोक)\b/i.test(lower)) {
          document.getElementById('freezeBtn')?.click();
          answer = lang === 'hi-IN'
            ? 'खाता फ्रीज स्थिति को तुरंत बदल दिया गया है।'
            : 'Your account emergency lock has been toggled successfully.';
        } else {
          answer = lang === 'hi-IN'
            ? 'सहाय बैंक में आपका स्वागत है। मैं आपका AI सहायक हूँ। आप मुझसे बैलेंस, पैसे भेजने या लेन-देन के बारे में पूछ सकते हैं।'
            : `I understood: "${q}". Sahaay AI can check your balance, review recent debits/credits, help you send money, or emergency lock your account.`;
        }

        appendMobileAiMsg(answer, false);
        window.SahaayVoice?.speakText?.(answer, lang);
      }, 500);
    };

    document.querySelectorAll('.mobile-ai-chip').forEach(chip => {
      chip.addEventListener('click', () => {
        handleMobileAiQuery(chip.dataset.prompt);
      });
    });

    document.getElementById('mobileAiChatSendBtn')?.addEventListener('click', () => {
      const input = document.getElementById('mobileAiChatInput');
      if (input && input.value) {
        handleMobileAiQuery(input.value);
        input.value = '';
      }
    });

    document.getElementById('mobileAiChatInput')?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        const input = document.getElementById('mobileAiChatInput');
        if (input && input.value) {
          handleMobileAiQuery(input.value);
          input.value = '';
        }
      }
    });

    document.getElementById('mobileAiVoiceMicBtn')?.addEventListener('click', () => {
      const mic = document.getElementById('mobileAiVoiceMicBtn');
      mic?.classList.toggle('listening');
      window.SahaayVoice?.startListening?.();
    });
  }

    initMobileAppUI();

    // Check backend health on load
    window.SahaayAPI.checkBackendHealth().then(online => {
      if(online) console.log('✓ Sahaay Bank Backend connected at ' + window.SahaayConfig.apiBaseUrl);
      else console.log('ℹ Sahaay Bank running in client-resilient offline fallback mode.');
    });

    // Welcome announcement for disability setup page on start
    setTimeout(() => {
      const promptText = 'Welcome to Sahaay Bank. Please choose your assistance setup: Blind, Low Vision, Motor Assistance, Senior Citizen, or Standard Banking.';
      window.SahaayVoice.speakText(promptText, 'en-IN', () => {
        window.SahaayVoice.startListening();
      });
    }, 700);
  }

  return {
    init,
    navigateTo,
    showToast,
    enterDashboard,
    signOut,
    selectDisabilityAndProceed,
    attemptLogin,
    prepareTransfer,
    refreshAccountBalance,
    loadTransactions,
    renderTransactions,
    updateBalanceDisplay,
    revealBalance: () => {
      const balEl = document.getElementById('mainBalanceText');
      const toggleBtnText = document.getElementById('toggleBalanceText');
      if(balEl) {
        balEl.innerHTML = `${balEl.dataset.real || '₹ 42,180.50'} <span class="smart-tag" style="${document.documentElement.classList.contains('highlight-info') ? 'display:inline-block;' : 'display:none;'}">[AVAILABLE]</span>`;
      }
      if(toggleBtnText) toggleBtnText.textContent = 'Hide Balance';
    }
  };
})();

// Bootstrap everything once DOM is ready
document.addEventListener('DOMContentLoaded', () => {
  window.SahaayFace?.init();
  window.SahaayVoice.init();
  window.SahaayUpi.init();
  window.SahaayQr.init();
  window.SahaayA11y.init();
  window.SahaayAi.init();
  window.SahaayApp.init();
});
